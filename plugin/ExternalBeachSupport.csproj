<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ExternalBeachSupport</AssemblyName>
    <RootNamespace>ExternalBeachSupport</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Referenced out of the game's own MelonLoader install. The Il2Cpp assemblies
    are generated on first launch from this exact build of the game; no package
    could supply them.

    Forward slashes throughout: MSBuild accepts them on Windows too, and the
    game folder now has to be found on two platforms rather than one.
  -->
  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir Condition="'$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Surf Sandbox</GameDir>
    <GameDir Condition="'$(OS)' != 'Windows_NT'">$(HOME)/Library/Application Support/Steam/steamapps/common/Surf Sandbox</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <MLDir>$(GameDir)/MelonLoader</MLDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MLDir)/net6/MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MLDir)/net6/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MLDir)/net6/Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(MLDir)/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MLDir)/Il2CppAssemblies/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MLDir)/Il2CppAssemblies/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MLDir)/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MLDir)/Il2CppAssemblies/Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
