<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A peer that is not a game.
    Compiles the same Net sources the mod does, so what it exercises is the
    shipping transport rather than a mock of it.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GhostPeer</AssemblyName>
    <RootNamespace>TidePool.SurfMP.Ghost</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/Net/*.cs" />
  </ItemGroup>

</Project>
