<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exercises the netcode without the game.

    Session and the transport were kept free of any MelonLoader or Unity
    dependency precisely so this could exist: real sockets on localhost, real
    packets, run from a terminal in two seconds. The alternative is launching
    Surf Sandbox twice and surfing to find out whether a handshake works.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SurfMP.Harness</AssemblyName>
    <RootNamespace>TidePool.SurfMP.Harness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The Net sources now include the Steam transport, so this needs the same
    package to compile them. Nothing here exercises Steam — it cannot be, since
    Steam's IPC pipe is per-session and these tests run headless — but the UDP
    transport and the session logic above it still can be, and that is the point.
  -->
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="../src/Net/*.cs" />
  </ItemGroup>

</Project>
