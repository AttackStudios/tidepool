{
  "name": "tidepool",
  "version": "0.0.1",
  "private": true,
  "description": "Mod manager for Surf Sandbox",
  "author": "AttackStudios",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build:dev && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "icons": "python3 tools/make-icon.py",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist": "npm run build && electron-builder --mac --win --publish never",
    "launch:check": "node tools/check-launch-copy.mjs",
    "build:renderer:dev": "vite build --mode development",
    "build:dev": "npm run build:main && npm run build:renderer:dev",
    "breaks": "npm run build:main && node tools/build-breaks.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "gg.tidepool.manager",
    "productName": "TidePool",
    "copyright": "Copyright \u00a9 2026 AttackStudios",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "TidePool-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "TidePool ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TidePool-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TidePool",
      "uninstallDisplayName": "TidePool Mod Manager",
      "artifactName": "TidePool-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AttackStudios",
        "repo": "tidepool"
      }
    ]
  }
}
